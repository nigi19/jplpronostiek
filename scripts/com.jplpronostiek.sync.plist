<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jplpronostiek.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/nielsgielen/Documents/Personal/voetbalpronostiek/scripts/sofascore_sync.py</string>
    </array>

    <!-- Run daily at 04:00 — after most late matches have final scores -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/jplpronostiek_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/jplpronostiek_sync_err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
