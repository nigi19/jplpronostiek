# Copy this to .env.local and fill in your values

# Neon Postgres — use the dev branch URL locally
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET=""          # openssl rand -base64 32

# Resend — for magic-link emails (free tier: 100/day)
AUTH_RESEND_KEY=""      # re_xxxx from resend.com
EMAIL_FROM="pronostiek@yourdomain.com"

# Data import (from GitHub Actions / sofascore_sync.py)
IMPORT_SECRET=""        # any random string — must match in GitHub Actions secret

# Optional: trigger GitHub Actions sync from /admin "Sync now" button
# Needs a GitHub PAT with "workflow" scope, or a fine-grained token
GITHUB_SYNC_TOKEN=""
GITHUB_REPO="nigi19/jplpronostiek"

# Comma-separated list of admin email addresses
ADMIN_EMAILS="nielsgielen322@gmail.com"

# App URL (set to https://yourdomain.vercel.app in prod)
NEXTAUTH_URL="http://localhost:3000"
